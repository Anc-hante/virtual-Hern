<Window x:Class="HernandesCheckout.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:local="clr-namespace:HernandesCheckout"
        Title="Hernandes Checkout"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowState="Maximized"
        Background="White"
        KeyDown="Window_KeyDown"
        Closing="Window_Closing">
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border x:Name="StatusBar"
                Grid.Row="0"
                Height="46"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="0,0,0,1">
            <Grid>
                <ProgressBar x:Name="LoadProgress"
                             Height="3"
                             VerticalAlignment="Bottom"
                             Minimum="0"
                             Maximum="100"
                             BorderThickness="0"
                             Foreground="#A7191F"
                             Background="#F3F4F6"/>

                <TextBlock x:Name="StatusText"
                           Text="Carregando Hernandes Checkout..."
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="#7F1D1D"
                           FontFamily="Segoe UI Variable Text, Segoe UI"
                           FontSize="14"
                           FontWeight="SemiBold"/>
            </Grid>
        </Border>

        <Grid x:Name="ContentHost"
              Grid.Row="1"
              Background="White">
            <wv2:WebView2 x:Name="Browser"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          DefaultBackgroundColor="White"/>

            <Border x:Name="StartupError"
                    Width="620"
                    Padding="32"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="White"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="24"
                    Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Não foi possível abrir o checkout"
                               FontFamily="Segoe UI Variable Display, Segoe UI"
                               FontWeight="Bold"
                               FontSize="28"
                               Foreground="#20242A"
                               TextAlignment="Center"/>

                    <TextBlock x:Name="ErrorText"
                               Margin="0,12,0,22"
                               FontSize="16"
                               Foreground="#667085"
                               TextWrapping="Wrap"
                               TextAlignment="Center"/>

                    <Button Height="58"
                            Content="Tentar novamente"
                            Style="{StaticResource PrimaryKeyStyle}"
                            Click="RetryButton_Click"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border x:Name="KeyboardContainer"
                Grid.Row="2"
                Height="0"
                Background="Transparent"
                Opacity="0"
                IsHitTestVisible="False">
            <local:VirtualKeyboard x:Name="Keyboard"/>
        </Border>
    </Grid>
</Window>
