<Window x:Class="HernandesCheckout.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:local="clr-namespace:HernandesCheckout"
        Title="Hernandes Checkout"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowState="Maximized"
        Background="White"
        KeyDown="Window_KeyDown"
        Closing="Window_Closing">
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border x:Name="StatusBar"
                Grid.Row="0"
                Height="52"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="0,0,0,1">
            <Grid Margin="14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Padding="12,6"
                        VerticalAlignment="Center"
                        Background="#FDEBEC"
                        CornerRadius="999">
                    <TextBlock Text="HERNANDES CHECKOUT"
                               Foreground="#A7191F"
                               FontFamily="Segoe UI Variable Display, Segoe UI"
                               FontSize="12"
                               FontWeight="Bold"/>
                </Border>

                <TextBlock x:Name="StatusText"
                           Grid.Column="1"
                           Margin="14,0"
                           Text="Carregando Hernandes Checkout..."
                           VerticalAlignment="Center"
                           Foreground="#667085"
                           FontFamily="Segoe UI Variable Text, Segoe UI"
                           FontSize="13"
                           FontWeight="SemiBold"/>

                <Button x:Name="RestartButton"
                        Grid.Column="2"
                        MinWidth="190"
                        Height="38"
                        Padding="14,0"
                        VerticalAlignment="Center"
                        Content="↻  Reiniciar e-commerce"
                        Foreground="#A7191F"
                        Background="#FFF6F6"
                        BorderBrush="#EAB5B7"
                        BorderThickness="1"
                        FontFamily="Segoe UI Variable Text, Segoe UI"
                        FontSize="13"
                        FontWeight="Bold"
                        Cursor="Hand"
                        Click="RestartButton_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="RestartBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="11">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="RestartBorder"
                                            Property="Background"
                                            Value="#FDEBEC"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.55"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <ProgressBar x:Name="LoadProgress"
                             Grid.ColumnSpan="3"
                             Height="3"
                             VerticalAlignment="Bottom"
                             Minimum="0"
                             Maximum="100"
                             BorderThickness="0"
                             Foreground="#A7191F"
                             Background="#F3F4F6"/>
            </Grid>
        </Border>

        <Grid x:Name="ContentHost"
              Grid.Row="1"
              Background="White">
            <wv2:WebView2 x:Name="Browser"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          DefaultBackgroundColor="White"/>

            <Border x:Name="StartupError"
                    Width="620"
                    Padding="32"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="White"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="24"
                    Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Não foi possível abrir o checkout"
                               FontFamily="Segoe UI Variable Display, Segoe UI"
                               FontWeight="Bold"
                               FontSize="28"
                               Foreground="#20242A"
                               TextAlignment="Center"/>

                    <TextBlock x:Name="ErrorText"
                               Margin="0,12,0,22"
                               FontSize="16"
                               Foreground="#667085"
                               TextWrapping="Wrap"
                               TextAlignment="Center"/>

                    <Button Height="58"
                            Content="Tentar novamente"
                            Style="{StaticResource PrimaryKeyStyle}"
                            Click="RetryButton_Click"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border x:Name="KeyboardContainer"
                Grid.Row="2"
                Height="0"
                Background="Transparent"
                Opacity="0"
                IsHitTestVisible="False">
            <local:VirtualKeyboard x:Name="Keyboard"/>
        </Border>
    </Grid>
</Window>
