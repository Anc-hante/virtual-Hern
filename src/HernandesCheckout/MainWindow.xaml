<Window x:Class="HernandesCheckout.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:local="clr-namespace:HernandesCheckout"
        Title="Hernandes Checkout"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowState="Maximized"
        Background="White"
        KeyDown="Window_KeyDown"
        Closing="Window_Closing">
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border x:Name="StatusBar"
                Grid.Row="0"
                Height="58"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="0,0,0,1">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="BackButton"
                        Grid.Column="0"
                        Width="124"
                        Height="42"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        Content="←  Voltar"
                        Foreground="White"
                        Background="#A7191F"
                        BorderBrush="#A7191F"
                        BorderThickness="1"
                        FontFamily="Segoe UI Variable Text, Segoe UI"
                        FontSize="15"
                        FontWeight="Bold"
                        Cursor="Hand"
                        IsEnabled="False"
                        Click="BackButton_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="BackBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="13">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="BackBorder"
                                            Property="Background"
                                            Value="#851419"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="BackBorder"
                                            Property="Background"
                                            Value="#E5E7EB"/>
                                    <Setter TargetName="BackBorder"
                                            Property="BorderBrush"
                                            Value="#E5E7EB"/>
                                    <Setter Property="Foreground"
                                            Value="#9CA3AF"/>
                                    <Setter Property="Opacity"
                                            Value="0.8"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Border Grid.Column="1"
                        Padding="12,6"
                        VerticalAlignment="Center"
                        Background="#FDEBEC"
                        CornerRadius="999">
                    <TextBlock Text="HERNANDES CHECKOUT"
                               Foreground="#A7191F"
                               FontFamily="Segoe UI Variable Display, Segoe UI"
                               FontSize="12"
                               FontWeight="Bold"/>
                </Border>

                <TextBlock x:Name="StatusText"
                           Grid.Column="2"
                           Margin="14,0"
                           Text="Abrindo checkout..."
                           VerticalAlignment="Center"
                           Foreground="#667085"
                           FontFamily="Segoe UI Variable Text, Segoe UI"
                           FontSize="13"
                           FontWeight="SemiBold"/>

                <Button x:Name="SettingsButton"
                        Grid.Column="3"
                        Width="46"
                        Height="40"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        Content="⚙"
                        ToolTip="Configurações administrativas"
                        Foreground="#A7191F"
                        Background="#FFF6F6"
                        BorderBrush="#EAB5B7"
                        BorderThickness="1"
                        FontFamily="Segoe UI Symbol, Segoe UI"
                        FontSize="20"
                        FontWeight="Bold"
                        Cursor="Hand"
                        Click="SettingsButton_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="SettingsBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="11">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="SettingsBorder"
                                            Property="Background"
                                            Value="#FDEBEC"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.55"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button x:Name="RestartButton"
                        Grid.Column="4"
                        MinWidth="190"
                        Height="40"
                        Padding="14,0"
                        VerticalAlignment="Center"
                        Content="↻  Reiniciar e-commerce"
                        Foreground="#A7191F"
                        Background="#FFF6F6"
                        BorderBrush="#EAB5B7"
                        BorderThickness="1"
                        FontFamily="Segoe UI Variable Text, Segoe UI"
                        FontSize="13"
                        FontWeight="Bold"
                        Cursor="Hand"
                        Click="RestartButton_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="RestartBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="11">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="RestartBorder"
                                            Property="Background"
                                            Value="#FDEBEC"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.55"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <ProgressBar x:Name="LoadProgress"
                             Grid.ColumnSpan="5"
                             Height="3"
                             VerticalAlignment="Bottom"
                             Minimum="0"
                             Maximum="100"
                             BorderThickness="0"
                             Foreground="#A7191F"
                             Background="#F3F4F6"/>
            </Grid>
        </Border>

        <Grid x:Name="ContentHost"
              Grid.Row="1"
              Background="White">
            <wv2:WebView2 x:Name="Browser"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          DefaultBackgroundColor="White"/>

            <Grid x:Name="CompletionScreen"
                  Visibility="Collapsed"
                  Background="#F8F9FA">
                <Canvas x:Name="ConfettiCanvas"
                        IsHitTestVisible="False"
                        ClipToBounds="True"/>

                <Border Width="680"
                        Padding="46,42"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="White"
                        BorderBrush="#ECEEF1"
                        BorderThickness="1"
                        CornerRadius="28">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="32"
                                          ShadowDepth="10"
                                          Opacity="0.13"/>
                    </Border.Effect>

                    <StackPanel>
                        <Border Width="96"
                                Height="96"
                                HorizontalAlignment="Center"
                                Background="#EDF9EF"
                                CornerRadius="48">
                            <TextBlock Text="✓"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="#218838"
                                       FontSize="52"
                                       FontWeight="Bold"/>
                        </Border>

                        <TextBlock Margin="0,22,0,0"
                                   HorizontalAlignment="Center"
                                   Text="PEDIDO CONCLUÍDO"
                                   Foreground="#A7191F"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   />

                        <TextBlock Margin="0,8,0,0"
                                   Text="Obrigado pela sua compra!"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Foreground="#20242A"
                                   FontFamily="Segoe UI Variable Display, Segoe UI"
                                   FontSize="38"
                                   FontWeight="Bold"/>

                        <TextBlock Margin="18,14,18,0"
                                   Text="Seu pedido foi finalizado com sucesso."
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Foreground="#667085"
                                   FontSize="19"/>

                        <Border Margin="8,24,8,0"
                                Padding="18"
                                Background="#FFF7E8"
                                BorderBrush="#F3D08A"
                                BorderThickness="1"
                                CornerRadius="14">
                            <StackPanel>
                                <TextBlock Text="🧾  Aguarde o cupom"
                                           TextAlignment="Center"
                                           Foreground="#8A5A00"
                                           FontSize="18"
                                           FontWeight="Bold"/>
                                <TextBlock Margin="0,6,0,0"
                                           Text="Por favor, aguarde a impressora terminar de imprimir o cupom antes de retirá-lo."
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           Foreground="#6B4A0A"
                                           FontSize="16"
                                           LineHeight="23"/>
                            </StackPanel>
                        </Border>

                        <Button x:Name="CompletionHomeButton"
                                Margin="36,28,36,0"
                                Height="68"
                                Content="Iniciar novo atendimento"
                                Style="{StaticResource PrimaryKeyStyle}"
                                FontSize="20"
                                Click="CompletionHomeButton_Click"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border x:Name="StartupError"
                    Width="620"
                    Padding="32"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="White"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="24"
                    Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Não foi possível abrir o checkout"
                               FontFamily="Segoe UI Variable Display, Segoe UI"
                               FontWeight="Bold"
                               FontSize="28"
                               Foreground="#20242A"
                               TextAlignment="Center"/>

                    <TextBlock x:Name="ErrorText"
                               Margin="0,12,0,22"
                               FontSize="16"
                               Foreground="#667085"
                               TextWrapping="Wrap"
                               TextAlignment="Center"/>

                    <Button Height="58"
                            Content="Tentar novamente"
                            Style="{StaticResource PrimaryKeyStyle}"
                            Click="RetryButton_Click"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border x:Name="KeyboardContainer"
                Grid.Row="2"
                Height="0"
                Background="Transparent"
                Opacity="0"
                IsHitTestVisible="False">
            <local:VirtualKeyboard x:Name="Keyboard"/>
        </Border>
    </Grid>
</Window>
