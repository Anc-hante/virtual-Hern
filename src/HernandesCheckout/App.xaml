<Application x:Class="HernandesCheckout.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <SolidColorBrush x:Key="HernandesRed" Color="#A7191F"/>
        <SolidColorBrush x:Key="KeyBorder" Color="#D6DBE2"/>
        <SolidColorBrush x:Key="KeyPressed" Color="#E5E7EB"/>
        <SolidColorBrush x:Key="KeyText" Color="#252B33"/>

        <Style x:Key="TouchKeyStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource KeyText}"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource KeyBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="MinHeight" Value="54"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="KeyBorderElement"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="13"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="KeyBorderElement"
                                        Property="Background"
                                        Value="{StaticResource KeyPressed}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NumberKeyStyle"
               TargetType="Button"
               BasedOn="{StaticResource TouchKeyStyle}">
            <Setter Property="Background" Value="#E9EDF2"/>
        </Style>

        <Style x:Key="DangerKeyStyle"
               TargetType="Button"
               BasedOn="{StaticResource TouchKeyStyle}">
            <Setter Property="Background" Value="#E2E5E9"/>
            <Setter Property="Foreground" Value="#343A40"/>
        </Style>

        <Style x:Key="ShiftKeyStyle"
               TargetType="Button"
               BasedOn="{StaticResource TouchKeyStyle}">
            <Setter Property="Background" Value="#E9EDF2"/>
            <Setter Property="Foreground" Value="#4B5563"/>
            <Setter Property="FontSize" Value="15"/>
        </Style>

        <Style x:Key="ShiftActiveKeyStyle"
               TargetType="Button"
               BasedOn="{StaticResource TouchKeyStyle}">
            <Setter Property="Background" Value="#FDEBEC"/>
            <Setter Property="BorderBrush" Value="#A7191F"/>
            <Setter Property="Foreground" Value="#A7191F"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="PrimaryKeyStyle"
               TargetType="Button"
               BasedOn="{StaticResource TouchKeyStyle}">
            <Setter Property="Background" Value="{StaticResource HernandesRed}"/>
            <Setter Property="BorderBrush" Value="{StaticResource HernandesRed}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </Application.Resources>
</Application>
