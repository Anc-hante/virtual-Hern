<Window x:Class="HernandesCheckout.PrinterSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuração de impressora"
        Width="720"
        Height="650"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="Transparent"
        AllowsTransparency="True"
        ShowInTaskbar="False">
    <Border Margin="18"
            Padding="28"
            Background="White"
            BorderBrush="#E5E7EB"
            BorderThickness="1"
            CornerRadius="24">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28"
                              ShadowDepth="8"
                              Opacity="0.18"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Configurar impressora do totem"
                               Foreground="#20242A"
                               FontFamily="Segoe UI Variable Display, Segoe UI"
                               FontSize="28"
                               FontWeight="Bold"/>

                    <TextBlock Margin="0,6,0,0"
                               Text="Escolha a impressora conectada ao Windows, faça um teste e salve a opção usada nos cupons."
                               Foreground="#667085"
                               FontSize="14"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Width="44"
                        Height="44"
                        Content="✕"
                        Background="#F7F8FA"
                        Foreground="#475467"
                        BorderBrush="#E4E7EC"
                        BorderThickness="1"
                        FontSize="16"
                        FontWeight="Bold"
                        Cursor="Hand"
                        Click="CloseButton_Click"/>
            </Grid>

            <Border Grid.Row="1"
                    Margin="0,20,0,0"
                    Padding="14"
                    Background="#F9FAFB"
                    BorderBrush="#EAECF0"
                    BorderThickness="1"
                    CornerRadius="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Impressora atualmente salva"
                                   Foreground="#667085"
                                   FontSize="12"
                                   FontWeight="SemiBold"/>

                        <TextBlock x:Name="CurrentPrinterText"
                                   Margin="0,4,0,0"
                                   Text="Nenhuma impressora configurada"
                                   Foreground="#20242A"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Width="150"
                            Height="42"
                            Margin="16,0,0,0"
                            Content="↻ Atualizar lista"
                            Background="White"
                            Foreground="#344054"
                            BorderBrush="#D0D5DD"
                            BorderThickness="1"
                            FontSize="13"
                            FontWeight="Bold"
                            Cursor="Hand"
                            Click="RefreshPrintersButton_Click"/>
                </Grid>
            </Border>

            <Border Grid.Row="2"
                    Margin="0,16,0,0"
                    BorderBrush="#E4E7EC"
                    BorderThickness="1"
                    CornerRadius="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Padding="14,12"
                            Background="#F7F8FA"
                            CornerRadius="14,14,0,0">
                        <TextBlock Text="Impressoras encontradas neste computador"
                                   Foreground="#344054"
                                   FontSize="14"
                                   FontWeight="Bold"/>
                    </Border>

                    <ListBox x:Name="PrintersList"
                             Grid.Row="1"
                             Margin="8"
                             BorderThickness="0"
                             Background="White"
                             FontSize="16"
                             SelectionChanged="PrintersList_SelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="MinHeight" Value="52"/>
                                <Setter Property="Margin" Value="0,2"/>
                                <Setter Property="Padding" Value="12,8"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Setter Property="Background" Value="White"/>
                                <Setter Property="BorderBrush" Value="#EAECF0"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ItemBorder"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="10"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBorder"
                                                            Property="Background"
                                                            Value="#FDEBEC"/>
                                                    <Setter TargetName="ItemBorder"
                                                            Property="BorderBrush"
                                                            Value="#A7191F"/>
                                                    <Setter Property="Foreground"
                                                            Value="#A7191F"/>
                                                    <Setter Property="FontWeight"
                                                            Value="Bold"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Grid>
            </Border>

            <TextBlock x:Name="StatusText"
                       Grid.Row="3"
                       MinHeight="22"
                       Margin="0,14,0,0"
                       Foreground="#667085"
                       FontSize="13"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"/>

            <Grid Grid.Row="4"
                  Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1.25*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Height="52"
                        Margin="0,0,6,0"
                        Content="Fechar"
                        Background="#F7F8FA"
                        Foreground="#303741"
                        BorderBrush="#D9DEE5"
                        BorderThickness="1"
                        FontSize="15"
                        FontWeight="Bold"
                        Cursor="Hand"
                        Click="CloseButton_Click"/>

                <Button x:Name="TestButton"
                        Grid.Column="1"
                        Height="52"
                        Margin="6,0"
                        Content="🧾 Testar impressão"
                        Background="White"
                        Foreground="#A7191F"
                        BorderBrush="#EAB5B7"
                        BorderThickness="1"
                        FontSize="15"
                        FontWeight="Bold"
                        Cursor="Hand"
                        IsEnabled="False"
                        Click="TestButton_Click"/>

                <Button x:Name="SaveButton"
                        Grid.Column="2"
                        Height="52"
                        Margin="6,0,0,0"
                        Content="Salvar impressora"
                        Style="{StaticResource PrimaryKeyStyle}"
                        FontSize="15"
                        IsEnabled="False"
                        Click="SaveButton_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
