<UserControl x:Class="HernandesCheckout.VirtualKeyboard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="458"
             Focusable="False"
             IsHitTestVisible="True">
    <Border Background="#F3F4F6"
            BorderBrush="#A7191F"
            BorderThickness="0,3,0,0"
            Padding="14,8,14,14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <TextBlock Text="HERNANDES  •  TECLADO VIRTUAL"
                           VerticalAlignment="Center"
                           Foreground="#7F1D1D"
                           FontFamily="Segoe UI Variable Display, Segoe UI"
                           FontWeight="Bold"
                           FontSize="13"/>

                <Button x:Name="CloseButton"
                        Width="40"
                        Height="32"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Content="×"
                        ToolTip="Fechar teclado"
                        FontSize="26"
                        FontWeight="Normal"
                        Foreground="#6B7280"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Focusable="False"
                        Click="CloseButton_Click"/>
            </Grid>

            <StackPanel x:Name="RowsHost"
                        Grid.Row="1"
                        VerticalAlignment="Stretch"/>
        </Grid>
    </Border>
</UserControl>
